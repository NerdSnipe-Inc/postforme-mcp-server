{
  "name": "@nerdsnipe-inc/postforme-mcp-server",
  "version": "1.0.1",
  "description": "A Model Context Protocol (MCP) server for the Post for Me API — giving any AI agent full access to schedule, publish, and manage social media posts.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "postforme",
    "post-for-me",
    "social-media",
    "social-posting",
    "ai",
    "claude",
    "cursor",
    "automation"
  ],
  "homepage": "https://github.com/Nerdsnipe-Inc/postforme-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/Nerdsnipe-Inc/postforme-mcp-server/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NerdSnipe-Inc/postforme-mcp-server.git"
  },
  "license": "MIT",
  "author": "NerdSnipe Inc <hello@nerdsnipe.cc>",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "postforme-mcp-server": "bin/postforme-mcp-server.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "dotenv": "^16.4.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.1.7",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
